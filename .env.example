# Local development can use a libSQL-backed SQLite file; production uses a Turso libsql:// URL.
TURSO_DATABASE_URL=file:./data/loti.sqlite
TURSO_AUTH_TOKEN=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Operator-only; pass securely for user:create or user:reset-password. Never commit a real password.
LOTI_USER_PASSWORD=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=

RESEND_API_KEY=
# disabled by default; enable only after DNS, migration and environment review.
LOTI_EMAIL_MODE=disabled
# Optional, only if this address actually receives replies.
LOTI_EMAIL_REPLY_TO=
# Exact comma-separated addresses allowed for real sends outside Vercel Production.
LOTI_EMAIL_TEST_RECIPIENTS=
LOTI_EMAIL_DAILY_LIMIT=60
LOTI_EMAIL_MONTHLY_LIMIT=1800
LOTI_EMAIL_RESET_RESERVE=20
LOTI_EMAIL_RESET_MONTHLY_RESERVE=600
LOTI_RESET_EMAIL_HOURLY_LIMIT=3
LOTI_RESET_IP_HOURLY_LIMIT=5
LOTI_LOGIN_EMAIL_HOURLY_LIMIT=30
LOTI_LOGIN_IP_HOURLY_LIMIT=100
LOTI_VERIFY_EMAIL_HOURLY_LIMIT=2
LOTI_VERIFY_EMAIL_DAILY_LIMIT=5
LOTI_INVITE_EMAIL_DAILY_LIMIT=3
LOTI_INVITE_WORKSPACE_DAILY_LIMIT=10
LOTI_INVITE_GLOBAL_DAILY_LIMIT=20
