# Local development can use a libSQL-backed SQLite file; production uses a Turso libsql:// URL.
TURSO_DATABASE_URL=file:./data/loti.sqlite
TURSO_AUTH_TOKEN=

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Operator-only; pass securely for user:create or user:reset-password. Never commit a real password.
LOTI_USER_PASSWORD=

R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_WRITE_ACCESS_KEY_ID=
R2_WRITE_SECRET_ACCESS_KEY=
R2_READ_ACCESS_KEY_ID=
R2_READ_SECRET_ACCESS_KEY=