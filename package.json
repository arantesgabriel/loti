{
  "name": "loti",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "benchmark:qc": "node --conditions=react-server --import tsx scripts/benchmark-qc-import.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --import tsx scripts/seed.ts",
    "user:create": "node --import tsx scripts/create-user.ts",
    "user:reset-password": "node --import tsx scripts/reset-password.ts",
    "auth:audit": "node --import tsx scripts/audit-auth.ts",
    "import:legacy": "node --import tsx scripts/import-legacy-spreadsheet.ts",
    "test:serve": "node --import tsx scripts/e2e-server.ts",
    "db:verify": "node --import tsx scripts/verify-database.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@aws-sdk/s3-request-presigner": "3.1150.0",
    "@better-auth/drizzle-adapter": "1.7.7",
    "@hookform/resolvers": "5.9.1",
    "@libsql/client": "0.18.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.5",
    "drizzle-orm": "0.45.3",
    "exceljs": "4.4.0",
    "geist": "1.7.2",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "resend": "6.34.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "turso": "0.6.0",
    "typescript": "6.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
